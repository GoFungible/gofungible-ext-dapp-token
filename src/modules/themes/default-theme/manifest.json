{
  "id": "default-theme",
  "name": "Default Light Theme",
  "version": "1.0.0",
  "description": "Default light theme for the application",
  "author": "Gofungible Team",
  "entryPoint": "default-theme",
  "extensionPoints": ["theme"],
  "theme": {
    "id": "default",
    "name": "Default Light",
    "description": "Default light theme for the application",
    "colors": {
      "primary": "#2563eb",
      "secondary": "#7c3aed",
      "background": "#f9fafb",
      "surface": "#ffffff",
      "text": "#111827",
      "accent": "#f59e0b",
      "border": "#e5e7eb",
      "muted": "#6b7280"
    },
    "fonts": {
      "sans": "ui-sans-serif, system-ui, -apple-system, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, monospace",
      "heading": "ui-sans-serif, system-ui, -apple-system, sans-serif"
    },
    "radius": "0.5rem",
    "mode": "light"
  }
}
